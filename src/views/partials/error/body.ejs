<div class="panel">
    <div class="error">
        <img class="logo" src="<%= app.host.assets %>/icon_text.png"/>
        <div id="title"><%= data.error.title %></div>
        <div id="message"><%= data.error.message %></div>
        <div id="actions"></div>
    </div>
    <img id="image" class="mascot" src="<%= app.host.assets %>/<%= data.error.image %>.webp"/>
</div>
<script>
    for (let action of "<%= data.error.actions %>".split(","))
    {
        let button = document.createElement("button");
        let onclick;

        if (actions.children.length == 0)
            button.classList.add("accent");

        if (action == "refresh") {
            button.innerText = "<%= language('general.refresh') %>";
            onclick = o => window.location.reload();
        }
        else if (action == "back") {
            button.innerText = "<%= language('general.back') %>";
            onclick = o => window.history.back();
        }
        else if (action == "homepage") {
            button.innerText = "<%= language('general.homepage') %>";
            onclick = o => window.location.href = "/";
        }
        else {
            button.innerText = action;
        }
        
        button.onclick = onclick;
        actions.append(button);
    }
</script>