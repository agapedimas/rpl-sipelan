<%- include('./style') %>

<div class="popover" id="verifyOtpPopover">
    <div class="activity">
        <div class="header cascaded">
            <span class="title"><%= language('profile.verify_otp_dialog.title') %></span>
            <div class="buttons">
                <button id="cancelVerifyOtpButton"><%= language('general.cancel') %></button>
            </div>
        </div>
        <div class="content">
            <div class="hero">
                <span class="icon">&#xf66c;</span>
                <span class="text">
                    <%- language('profile.verify_otp_dialog.description').format('<b id="verifyPhoneNumberText"></b>') %>
                </span>
            </div>
            <div class="inputs">
                <input type="text" id="otpCodeInput" ad-type="otp"/>
                <span class="error hidden" id="otpCodeError"></span>
                <button id="submitVerifyOtpButton" class="accent">
                    <div class="progressring"></div>
                    <%= language('general.verify') %>
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('./script') %>