<script>
    selectDomicileButton.onclick = async function() {
        const selectedDomicile = await selectDomicileAsync(this);
        editProfileFormData.set("districtId", selectedDomicile.districtId);
        editDomicileText.innerText = selectedDomicile.displayName;
        console.log("Domisili yang dipilih:", selectedDomicile);
    }
    const editProfileForm = new PopOverForm(
        [
            new Field(editNameInput),
            new Field(editPhoneInput),
            new Field(editNikInput)
        ],
        submitEditProfileButton,
        cancelEditProfileButton,
        editProfilePopover
    );

    let editProfileFormData = new FormData();
    let editProfilePictureFormData = new FormData();

    editProfilePopover.onbeforeopen = function() {
        editProfilePictureImage.src = profilePictureImage.src;
        editNameInput.value = "<%= data.account.name %>";
        editPhoneInput.value = Formatter.PhoneNumber("<%= data.account.phone %>");
        editNikInput.value = "<%= data.account.nik %>";
        editDomicileText.innerText = "<%= data.account.domicile %>";
        
        editProfileFormData = new FormData();
        editNameInput.oninput = function() {
            editProfileFormData.set("name", this.value);
        }
        editPhoneInput.oninput = function() {
            editProfileFormData.set("phone", this.value);
        }
        editNikInput.oninput = function() {
            editProfileFormData.set("nik", this.value);
        }
    }

    editProfilePictureButton.onclick = function() {
        const fileInput = document.createElement("input");
        fileInput.classList.add("hidden");
        fileInput.type = "file";
        fileInput.accept = ".png, .jpg, .jpeg, .webp";
        fileInput.onchange = function() {
            // Reset form each input's value changes
            editProfilePictureFormData = new FormData();
            const files = Array.from(this.files);

            if (files.length == 0)
                return;

            if (files[0].size > 3000000)
                return Components.Notification.Send({ 
                    Id: "avatar_failed", 
                    Title: "<%= language('profile.profile_picture.change.errors.title') %>", 
                    Message: "<%= language('profile.profile_picture.change.errors.TOO_BIG') %>", 
                    Icon: "\ufe64", 
                    Buttons: [{Text: "<%= language('general.ok') %>"}] 
                });
                
            editProfilePictureFormData.set("file", files[0]);
            editProfilePictureImage.src = URL.createObjectURL(files[0]);
            fileInput.remove();
        }
        this.parentNode.append(fileInput);
        fileInput.click();
    }

    submitEditProfileButton.onaction = function() {
        return new Promise(async function(resolve) {
            const isEditProfilePictureSuccess = await submitProfilePicture();
            
            if (isEditProfilePictureSuccess === false)
                return resolve(false);
    
            const isEditProfileSuccess = await submitEditProfile();
    
            if (isEditProfileSuccess === false)
                return resolve(false);
    
            // Reload page after the profile is updated,
            // and no need to return promise result.
            location.reload();
        })
    }
    
    async function submitProfilePicture() {
        // No need to do post request if user doesn't update their profile picture.
        if ([...editProfilePictureFormData.entries()].length == 0)
            return true;

        try {
            const uploadPictureRequest = await $.ajax({
                type: "post",
                url: "/pp",
                data: editProfilePictureFormData,
                contentType: false,
                processData: false
            })

            return true;
        }
        catch (result) {
            Components.Notification.Send({ 
                Id: "avatar_failed", 
                Title: "<%= language('profile.profile_picture.change.errors.title') %>", 
                Message: result.responseJSON?.message || "<%= language('profile.profile_picture.change.errors.UNKNOWN') %>".format(result.status), 
                Icon: "\ufe64", 
                Buttons: [{Text: "<%= language('general.ok') %>"}] 
            }); 

            return false;
        }
    }

    async function submitEditProfile() {
        // No need to do patch request if user doesn't update their profile.
        if ([...editProfileFormData.entries()].length == 0)
            return true;

        try {
            const submitRequest = 
                await fetch("/api/account/<%= data.account?.id %>", {
                    method: "PATCH",
                    body: editProfileFormData
                });

            const responseBody = await submitRequest.json();
            const data = responseBody?.data;

            if (submitRequest.ok) {
                if (data?.requireOtp == true) {
                    return await verifyOtpAsync();
                }
                else {
                    return true;
                }
            }
            else {
                throw new Error(
                    responseBody.message, { 
                        cause: { 
                            details: submitRequest.status 
                        }
                    }
                );
            }
        }
        catch (error) {
            Components.Notification.Send({ 
                Id: "update_account_failed", 
                Title: "<%= language('profile.errors.title') %>", 
                Message: error.message || "<%= language('profile.errors.UNKNOWN') %>".format(error.cause.details), 
                Icon: "\ufe64", 
                Buttons: [{Text: "<%= language('general.ok') %>"}] 
            }); 

            return false;
        }
    }
</script>