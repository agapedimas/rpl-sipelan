<script type="module">
    let domicileCallback = null;

    document.addEventListener("DOMContentLoaded", async function() {
        const provinces = await fetchProvinces();
        resetAndAppendProvinceItems(selectProvinceList, provinces);
    });
    
    async function selectDomicileAsync(element) {
        return new Promise(function(resolve) {
            domicileCallback = function(data) {
                resolve(data);
                selectDomicilePopover.close();
            }
            selectDomicilePopover.open(element);
            navigateDomicileActivityToProvinceList();
        })
    }

    cancelSelectDomicileButton.onclick = function() {
        selectDomicilePopover.close();
    }

    function navigateDomicileActivityToProvinceList() {
        const activity = selectDomicilePopover.container.children[0];
        activity.navigateTo(0, true);
    }
    function navigateDomicileActivityToCityList() {
        const activity = selectDomicilePopover.container.children[0];
        activity.navigateTo(1);
    }
    function navigateDomicileActivityToDistrictList() {
        const activity = selectDomicilePopover.container.children[0];
        activity.navigateTo(2);
    }

    async function fetchProvinces() {
        const response = await fetch("/api/province");
        const responseBody = await response.json();
        const data = responseBody?.data;
        return data?.provinces || [];
    }
    async function fetchCities(provinceId) {
        if (provinceId == null)
            return [];

        const response = await fetch("/api/city?provinceId=" + provinceId);
        const responseBody = await response.json();
        const data = responseBody?.data;
        return data?.cities || [];
    }
    async function fetchDomiciles(cityId) {
        if (cityId == null)
            return [];

        const response = await fetch("/api/domicile?cityId=" + cityId);
        const responseBody = await response.json();
        const data = responseBody?.data;
        return data?.domiciles || [];
    }
    function resetAndAppendProvinceItems(listElement, itemsData) {
        // Reset items
        listElement.clearItems();
        // Append items
        for (const itemData of itemsData || []) {
            const itemElement = renderCityOrProvinceItem(itemData);
            itemElement.onclick = onselected;
            listElement.append(itemElement);
        }
        async function onselected() {
            const provinceId = this.dataset.id;
            const cities = await fetchCities(provinceId);
            resetAndAppendCityItems(selectCityList, cities);
            navigateDomicileActivityToCityList();
        }
    }
    function resetAndAppendCityItems(listElement, itemsData) {
        // Reset items
        listElement.clearItems();
        // Append items
        for (const itemData of itemsData || []) {
            const itemElement = renderCityOrProvinceItem(itemData);
            itemElement.onclick = onselected;
            listElement.append(itemElement);
        }
        async function onselected() {
            const cityId = this.dataset.id;
            const domiciles = await fetchDomiciles(cityId);
            resetAndAppendDistrictItems(selectDistrictList, domiciles);
            navigateDomicileActivityToDistrictList();
        }
    }
    function resetAndAppendDistrictItems(listElement, itemsData) {
        // Reset items
        listElement.clearItems();
        // Append items
        for (const itemData of itemsData || []) {
            const itemElement = renderDistrictItem(itemData);
            itemElement.onclick = o => domicileCallback(itemElement.data.domicile);
            listElement.append(itemElement);
        }
    }
    function renderCityOrProvinceItem(itemData) {
        const labelElement = renderItemLabel(itemData.name);
        const chevronElement = renderItemChevron();
        const itemContainer = renderItemContainer(itemData.id, itemData.name, itemData.name);
        itemContainer.append(labelElement);
        itemContainer.append(chevronElement);
        return itemContainer;
    }
    function renderDistrictItem(itemData) {
        const labelElement = renderItemLabel(itemData.districtName);
        const emptyElement = renderItemLabel("");
        const itemContainer = renderItemContainer(itemData.id, itemData.districtName, itemData.displayName);
        itemContainer.append(labelElement);
        itemContainer.append(emptyElement);
        itemContainer.data = { domicile: itemData };
        return itemContainer;
    }
    function renderItemContainer(dataId, dataName, dataDisplayName) {
        const itemContainer = document.createElement("div");
        itemContainer.classList.add("stack", "clickable");
        itemContainer.dataset.id = dataId;
        itemContainer.dataset.name = dataName;
        itemContainer.dataset.displayName = dataDisplayName;
        return itemContainer;
    }
    function renderItemLabel(dataName) {
        const labelElement = document.createElement("span");
        labelElement.innerText = dataName;
        return labelElement;
    }
    function renderItemChevron() {
        const chevronElement = document.createElement("span");
        chevronElement.classList.add("icon");
        chevronElement.innerText = "\uef59";
        return chevronElement;
    }

    // Export methods
    window.selectDomicileAsync = selectDomicileAsync;
</script>