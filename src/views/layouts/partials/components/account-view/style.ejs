<style>
    .activity:has(section > #accountViewContent.show) {
        background: var(--background-activity-grid);
    }

    section:has(> #accountViewContent:not(.show)) 
    > .header > .buttons {
        opacity: 0;
        pointer-events: none;
    }

    section:has(> #accountViewContent:not(.show)) {
        display: grid;
        grid-auto-rows: 0 auto;

        .content {
            display: grid;
            text-align: center;
            align-items: center;
            justify-content: center;
            grid-auto-rows: auto;
        }
        
        .content > .noSelectionView {
            display: block;
        }
            .content > .noSelectionView > span{
                font-size: 1.5em;
                color: var(--foreground-description);
            }
        .content > .selected {
            display: none;
        }
    }

    section:has(> #accountViewContent.show) {
        background: inherit;

        .content > .noSelectionView {
            display: none;
        }
        .content > .selected {
            display: block;

            .profile {        
                display: grid;
                max-width: 800px;
                justify-items: center;
                margin-bottom: var(--padding);
                text-align: center;
                gap: 1em;
            }
                .profile .profilePicture {
                    width: 150px;
                    aspect-ratio: 1;
                    border-radius: 100%;
                    overflow: hidden;
                }
                    .profile .profilePicture img {
                        width: 100%;
                        aspect-ratio: 1;
                    }
                .profile .name {
                    font-size: 1.7em;
                    font-weight: bold;
                    line-height: 1;
                    text-align: center;
                }
        
            .actions {
                display: grid;
                grid-auto-flow: column;
                grid-auto-columns: 1fr;
                gap: 7px;
            }
                .actions button {
                    padding: 0.75em 1.25em;
                    border-radius: 12px;
                }
                    .actions button .progressring {
                        width: 1em;
                    }

            .list .stack > span:last-child {
                color: var(--foreground-description);
            }
        }
    }
    
</style>