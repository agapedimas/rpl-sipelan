<script type="module">
    const component = JSON.parse('<%- JSON.stringify(component) %>');
    let activeAccount = null;

    function setAccountView(account) {
        if (account == null) {
            accountViewContent.classList.remove("show");
            return;
        }

        const accountViewActivity = accountViewContent.parentElement.parentElement;

        if (activeAccount == account && accountViewActivity == secondaryActivity) {
            return;
        }

        activeAccount = account;
        assignAccountInfo(account);

        accountViewContent.classList.add("show");
        accountViewContent.parentElement.scrollTop = 0;

        if (accountViewActivity == mainActivity)
            mainActivity.navigateTo(1);
    }

    function assignAccountInfo(account) {
        accountViewContent.parentElement.name = account.name;
        accountViewNameText.innerText = account.name;
        accountProfilePictureImage.src = "/pp/" + account.id;
        accountPhoneText.innerText = account.phone;
        accountNikText.innerText = account.nik;
        accountDomicileText.innerText = account.domicile;

        if (account.isActive) {
            activateAccountButton.classList.add("hidden");
            deactivateAccountButton.classList.remove("hidden");
        }
        else {
            activateAccountButton.classList.remove("hidden");
            deactivateAccountButton.classList.add("hidden");
        }
    }

    deactivateAccountButton.onclick = function() {
        activeAccount.isActive = false;
        assignAccountInfo(activeAccount);
    }
    activateAccountButton.onclick = function() {
        activeAccount.isActive = true;
        assignAccountInfo(activeAccount);
    }

    window.setAccountView = setAccountView;
</script>