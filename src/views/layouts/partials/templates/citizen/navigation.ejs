<section class="desktop">
	<div class="navigation">
		<a ad-goto="/reports">
			<span class='icon'>&#xf0d7;</span>
			<span><%= language('report.title') %></span>
		</a>
		<a ad-goto="/submissions">
			<span class='icon'>&#xfcd6;</span>
			<span><%= language('submission.title') %></span>
		</a>
	</div> 
	<div class="footer">
		<a ad-goto="/profile">
			<img class='icon' ad-goto="/profile" src="/pp/<%= data.account?.id || 'default' %>"/>
			<span><%= data.account?.name || language('auth.signin.title') %></span>
		</a>
	</div>
</section>

<section class="mobile">
	<span class="navigation">	
		<a ad-goto="/reports">
			<span class='icon'>&#xf0d6;</span>
			<span><%= language('report.title') %></span>
		</a>
		<a ad-goto="/submissions">
			<span class='icon'>&#xfcd5;</span>
			<span><%= language('submission.title') %></span>
		</a>
		<a ad-goto="/profile">
			<span class='icon'>&#xf832;</span>
			<span><%= language('profile.title') %></span>
		</a>
	</span> 
</section>