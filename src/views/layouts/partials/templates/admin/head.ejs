<meta name="theme-color" content="#000000"> 
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"> 
<link rel="stylesheet" type="text/css" href="/css/style.css" />
<link rel="stylesheet" type="text/css" href="/css/forms.css" />
<link rel="stylesheet" type="text/css" href="/css/admin.css" />
<link rel="icon" href="<%= app.path.logo %>" />
<% if (data.page.title) { %>
    <title><%= data.page.title + " - " + app.name_for_admin %></title>
<% } else { %>
    <title><%= app.name_for_admin %></title>
<% } %>
<% if (data.page.usesSecondaryActivity === true) { %>
    <link rel="stylesheet" type="text/css" href="/css/secondary-activity.css" />
    <script src="/js/utils/secondary-activity.js" type="module"></script>
<% } %>