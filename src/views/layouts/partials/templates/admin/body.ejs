<script src="/js/utils/forms.js"></script>
<script src="/js/utils/input-validator.js"></script>

<header class="titlebar">
	<img class="icon" src="<%= app.path.logo_monochrome %>"/>
	<span class="name"><%= app.name_for_admin %></span>
</header>

<div class="root">
	<nav class="sidebar">
        <%- include("./navigation") %>
	</nav>
	<section class="main">
		<div class="activity" id="mainActivity">
            <%- body %>
		</div>
	<% if (data.page.usesSecondaryActivity === true) { %>
		<div class="activity" id="secondaryActivity">
			<div class="header"></div>
			<div class="content"></div>
		</div>
	<% } %>
	</section>
</div>