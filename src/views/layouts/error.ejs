<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport" />
        <meta content="#000000" name="theme-color"> 
        <meta content="#000000" name="apple-mobile-web-app-status-bar-style"> 
        <link rel="stylesheet" type="text/css" href="<%= app.host.assets %>/ui/v3/style.css" />
        <link rel="icon" href="<%= app.host.assets %>/icon_logo.ico" />
        <title><%= app.name %></title>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
        <script src="<%= app.host.assets %>/ui/v3/head.js"></script>
        <script src="<%= app.host.assets %>/ui/v3/components.js"></script>
        <script src="<%= app.host.assets %>/ui/v3/events.js"></script> 
		<style>
			html[theme=light]
			{
				background: var(--gray-6);
			}
			html[theme=dark]
			{
				background: var(--background-page);
			}

			.panel
			{
				position: fixed;
			    top: 50%;	
			    left: 50%;
			    transform: translate(-50%, -50%);
				display: grid;
				grid-auto-flow: column;
				background: var(--background-page);
				border-radius: 30px;
				overflow: hidden;
			}
			[theme=dark] .panel
			{
				background: var(--gray-6);
			}
				.panel > .error
				{
				    display: grid;
				    padding: 35px;
				    grid-auto-rows: max-content max-content auto max-content;
			        min-width: 300px;
			        max-width: 500px;
			        width: calc(50vw - 30px);
		            gap: 1em;
				}
					.panel .logo
					{
						height: 30px;
					}
					.panel #title
					{
					    font-size: 2.75rem;
					    line-height: 1.1;
					    font-family: var(--font-bold);
				        white-space: pre-line;
					}
					.panel #message
					{
					    font-size: 1.5rem;
				        white-space: pre-line;
					}
					.panel #actions
					{
					    display: grid;
					    grid-auto-flow: column;
					    grid-auto-columns: 1fr;
					    gap: 10px;
					    --accent: #c80000;
					}
						.panel #actions button
						{
							font-size: 1.2rem;
							border-radius: 10px;
							padding: 0.55em 0.75em;
							text-transform: capitalize;
						}
				.panel > img
				{
				    margin: 50px 0 0 75px;
				    height: 365px;
				    align-self: end;  
				    aspect-ratio: 390 / 365;
    				object-fit: cover;
				}
				[theme=dark]
				.panel > img
				{
					filter: brightness(0.875) contrast(1.075);
				}

			@media screen and (max-width: 950px)
			{
				.panel > img 
				{
				    margin: 50px 0 0 0;
				    height: 350px;
				}
			}

			@media screen and (max-width: 850px)
			{
				.panel > .error 
				{
				    width: calc(100vw - 30px);
				}
					.panel #title 
					{
					    font-size: 2.5rem;
					}
					.panel #message
					{
						margin-bottom: 0.35em;
					}
				.panel > img 
				{
					display: none;
				}
			}

			@media screen and (max-width: 600px)
			{
				.panel > .error 
				{
				    padding: 30px;
				}
					.panel .logo
					{
						height: 25px;
					}
					.panel #title 
					{
					    font-size: 2.15rem;
					}
					.panel #message
					{
					    font-size: 1.4rem;
						margin-bottom: 0.35em;
					}
					.panel #actions
					{
						grid-auto-flow: row;
					}
						.panel #actions button
						{
						    padding: 0.55em 1em;
						}
			}
		</style>
    </head>
    <body>
		<%- include("./partials/templates/error/body") %>
    </body>
</html>