<% 
    variables.session.page_title = language('auth.signup.title');
    variables.session.page_name = language('auth.signup.title');
    variables.session.page_description = null;
    variables.session.page_keywords = null;
    variables.session.page_thumbnail = null;
%>

<div class="panel">
    <img src="<%= variables.app.path.logo_wordmark %>" ad-goto="/"/>
    <div class="title"><%= language('auth.signup.title') %></div>
    <div class="subtitle"><%= language('auth.signup.description') %></div>
    <div class="inputs">
        <input type="email" id="emailInput" ad-text="<%= language('account.email.title') %>"/>
        <span class="error hidden" id="emailError"></span>
        <input type="text" ad-type="name" id="fullnameInput" ad-text="<%= language('account.fullname.title') %>"/>
        <span class="error hidden" id="fullnameError"></span>
        <input type="password" id="passwordInput" ad-text="<%= language('account.password.title') %>"/>
        <span class="error hidden" id="passwordError"></span>
        <input type="password" ad-type="confirmpassword" id="passwordConfirmInput" ad-text="<%= language('account.passwordconfirm.title') %>"/>
        <span class="error hidden" id="passwordConfirmError"></span>
    </div>
    <div class="actions">
        <span class="error hidden" id="generalError"></span>
        <button class="accent" id="signUpButton" disabled>
            <div class="progressring"></div>
            <span><%= language('auth.signup.title') %></span>
        </button>
        <div class="suggestion">
            <%= language('auth.signin.offer') %>
            <a class="link" ad-goto="/signin"><%= language('auth.signin.title') %></a>
        </div>
    </div>
</div>

<script>
    const signUpForm = new Form([
            new Field(emailInput, emailError),
            new Field(fullnameInput, fullnameError),
            new Field(passwordInput, passwordError),
            new Field(passwordConfirmInput, passwordConfirmError)
        ], signUpButton);

    signUpButton.onaction = function() {
        return new Promise(function(resolve) {
            generalError.classList.add("hidden");
            $.ajax({
                url: "/api/signup",
                type: "POST",
                data: { 
                    email: emailInput.value, 
                    password: passwordInput.value,
                    fullname: fullnameInput.value
                },
                success: function(response) {
                    window.location.replace(response.data.url);
                    resolve(true);
                },
                error: function(result) {
                    generalError.innerText = result.responseJSON?.error || "<%= language('auth.errors.something_went_wrong') %>";
                    generalError.classList.remove("hidden");
                    resolve(false);
                }
            });
        });
    }
</script>