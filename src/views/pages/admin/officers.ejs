<% 
    data.page.title = language('account.officer.title');
    data.page.usesSecondaryActivity = true;
%>

<section id="officerListSection">
    <div class="header">
        <div class="buttons">
            <button id="addOfficerButton"><%= language('general.add') %></button>
            <button id="filterByDomicileButton" class="icon">&#xf5bf;</button>
        </div>
        <span class="title"><%= data.page.title %></span>
        <input id="officerSearchInput" type="search" placeholder="<%= language('general.search')%>" ad-cancellabel="<%= language('general.cancel')%>"/>
    </div>

    <div class="content">
        <%- 
            include('/layouts/partials/components/account-list/body', {
                component: {
                    id: "officerList",
                    role: "officer",
                    isFilteredByDistrict: false
                }
            }) 
        %>
    </div>
</section>
<section id="officerViewSection">
    <%- 
        include('/layouts/partials/components/account-view/body', {
            component: {
                id: "officerView",
                role: "officer",
                allowEditing: true
            }
        }) 
    %>
</section>

<script>
    document.addEventListener("DOMContentLoaded", async function() {
        officerList.refreshList();
        officerList.setSearchBox(officerSearchInput);
        officerList.setItemClickAction(function(officerData) {
            setAccountView(officerData);
        });
        setSectionAsSecondActivity(officerViewSection);
    });

    filterByDomicileButton.onclick = async function() {
        const domicile = await selectDomicileAsync(filterByDomicileButton);
        const domicileName = domicile.districtName + ", " + domicile.cityName;
        officerList.setFilter(domicile.districtId, domicileName);
    }

    addOfficerButton.onclick = async function() {
        await addAccountAsync(this);
        officerList.refreshList();
    }
</script>

<%- include('/layouts/partials/components/select-domicile-popover/body'); %>